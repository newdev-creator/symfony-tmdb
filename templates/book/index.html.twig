{% extends 'base.html.twig' %}

{% block title %}Books{% endblock %}

{% block body %}
    <h1>Books</h1>
    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Status</th>
                <th>Rating</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for book in books %}
            <tr>
                <td>{{ book.title }}</td>
                <td>{{ book.author }}</td>
                <td>{{ book.status }}</td>
                <td>{{ book.rating }}</td>
                <td>
                    <a href="{{ path('app_book_show', { id: book.id }) }}">Show</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">No books found.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
